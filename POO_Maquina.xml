    <pous>
      <pou name="FB_ControlMarchaParo" pouType="functionBlock">
        <interface>
          <localVars>
            <variable name="_bSetaEmergenciaOk" address="%I*">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="_bPulsadorMarcha" address="%I*">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="_bPulsadorParo" address="%I*">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="_bPulsadorRearme" address="%I*">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="_bSalidaMotor" address="%Q*">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="_bEnMarcha">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="_bFalloSeguridad">
              <type>
                <BOOL />
              </type>
            </variable>
            <addData>
              <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
                <InterfaceAsPlainText>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_ControlMarchaParo
VAR
	// Canales de entrada fisica vinculados a terminales de proceso
	_bSetaEmergenciaOk	AT %I*	: BOOL; // Contacto normalmente cerrado (NC): TRUE = Circuito de seguridad cerrado
	_bPulsadorMarcha	AT %I*	: BOOL; // Contacto normalmente abierto (NA): TRUE = Pulsado
	_bPulsadorParo		AT %I*	: BOOL; // Contacto normalmente cerrado (NC): TRUE = Reposo, FALSE = Paro accionado
	_bPulsadorRearme	AT %I*	: BOOL; // Contacto normalmente abierto (NA): TRUE = Solicitud de rearme

	// Canal de salida fisica hacia contactor o actuador
	_bSalidaMotor		AT %Q*	: BOOL; // Activacion fisica de la marcha de la maquina

	// Variables privadas de estado interno
	_bEnMarcha					: BOOL; // Estado de enclavamiento de la marcha
	_bFalloSeguridad			: BOOL; // Memoria retenida de fallo de emergencia hasta rearme
END_VAR</xhtml>
                </InterfaceAsPlainText>
              </data>
            </addData>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml" />
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="M_Cyclic" ObjectId="a1b2c3d4-e5f6-4a5b-8c9d-0e1f2a3b4c5d">
              <interface />
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">// Supervisión del canal de emergencia: corte inmediato y retención de fallo si el circuito se abre
IF NOT _bSetaEmergenciaOk THEN
    _bFalloSeguridad := TRUE;
    _bEnMarcha := FALSE;
END_IF

// Supervisión del pulsador de paro (contacto NC): detención inmediata al abrirse el contacto
IF NOT _bPulsadorParo THEN
    _bEnMarcha := FALSE;
END_IF

// Gestión del rearme físico: eliminación del flag de fallo si la seta física se encuentra en circuito cerrado
IF _bPulsadorRearme AND _bSetaEmergenciaOk THEN
    _bFalloSeguridad := FALSE;
END_IF

// Gestión del pulsador físico de marcha: activación del enclavamiento si se cumplen los requisitos de seguridad
IF _bPulsadorMarcha AND P_ListoParaMarcha THEN
    _bEnMarcha := TRUE;
END_IF

// Asignación continua del estado de marcha a la salida física
_bSalidaMotor := _bEnMarcha;</xhtml>
                </ST>
              </body>
              <InterfaceAsPlainText>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">METHOD M_Cyclic</xhtml>
              </InterfaceAsPlainText>
              <addData />
            </Method>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="M_Marcha" ObjectId="b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d6e">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">// Activación de marcha por método: valida que la máquina esté lista y libre de fallos
IF P_ListoParaMarcha THEN
    _bEnMarcha := TRUE;
    M_Marcha := TRUE;
ELSE
    M_Marcha := FALSE;
END_IF</xhtml>
                </ST>
              </body>
              <InterfaceAsPlainText>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">METHOD M_Marcha : BOOL</xhtml>
              </InterfaceAsPlainText>
              <addData />
            </Method>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="M_Paro" ObjectId="c3d4e5f6-a7b8-4c9d-0e1f-2a3b4c5d6e7f">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">// Desconexión forzada del enclavamiento de marcha
_bEnMarcha := FALSE;
M_Paro := TRUE;</xhtml>
                </ST>
              </body>
              <InterfaceAsPlainText>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">METHOD M_Paro : BOOL</xhtml>
              </InterfaceAsPlainText>
              <addData />
            </Method>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="M_Rearmar" ObjectId="d4e5f6a7-b8c9-4d0e-1f2a-3b4c5d6e7f8a">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">// Restablecimiento del estado de seguridad mediante comando si el canal de emergencia está cerrado
IF _bSetaEmergenciaOk THEN
    _bFalloSeguridad := FALSE;
    M_Rearmar := TRUE;
ELSE
    M_Rearmar := FALSE;
END_IF</xhtml>
                </ST>
              </body>
              <InterfaceAsPlainText>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">METHOD M_Rearmar : BOOL</xhtml>
              </InterfaceAsPlainText>
              <addData />
            </Method>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/property" handleUnknown="implementation">
            <Property name="P_EmergenciaActiva" ObjectId="e5f6a7b8-c9d0-4e1f-2a3b-4c5d6e7f8a9b">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
              </interface>
              <GetAccessor>
                <interface />
                <body>
                  <ST>
                    <xhtml xmlns="http://www.w3.org/1999/xhtml">// Lectura del estado de emergencia: TRUE si hay fallo retenido o si la seta física está abierta
P_EmergenciaActiva := _bFalloSeguridad OR NOT _bSetaEmergenciaOk;</xhtml>
                  </ST>
                </body>
                <InterfaceAsPlainText>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">VAR
END_VAR</xhtml>
                </InterfaceAsPlainText>
                <addData />
              </GetAccessor>
              <InterfaceAsPlainText>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">PROPERTY P_EmergenciaActiva : BOOL</xhtml>
              </InterfaceAsPlainText>
              <addData />
            </Property>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/property" handleUnknown="implementation">
            <Property name="P_EnMarcha" ObjectId="f6a7b8c9-d0e1-4f2a-3b4c-5d6e7f8a9b0c">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
              </interface>
              <GetAccessor>
                <interface />
                <body>
                  <ST>
                    <xhtml xmlns="http://www.w3.org/1999/xhtml">// Lectura del estado operativo: indica si el motor o actuador se encuentra actualmente activo
P_EnMarcha := _bEnMarcha;</xhtml>
                  </ST>
                </body>
                <InterfaceAsPlainText>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">VAR
END_VAR</xhtml>
                </InterfaceAsPlainText>
                <addData />
              </GetAccessor>
              <InterfaceAsPlainText>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">PROPERTY P_EnMarcha : BOOL</xhtml>
              </InterfaceAsPlainText>
              <addData />
            </Property>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/property" handleUnknown="implementation">
            <Property name="P_ListoParaMarcha" ObjectId="a7b8c9d0-e1f2-4a3b-4c5d-6e7f8a9b0c1d">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
              </interface>
              <GetAccessor>
                <interface />
                <body>
                  <ST>
                    <xhtml xmlns="http://www.w3.org/1999/xhtml">// Retorno de condición de disponibilidad: requiere ausencia de emergencias y paro en reposo
P_ListoParaMarcha := NOT P_EmergenciaActiva AND _bPulsadorParo;</xhtml>
                  </ST>
                </body>
                <InterfaceAsPlainText>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">VAR
END_VAR</xhtml>
                </InterfaceAsPlainText>
                <addData />
              </GetAccessor>
              <InterfaceAsPlainText>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">PROPERTY P_ListoParaMarcha : BOOL</xhtml>
              </InterfaceAsPlainText>
              <addData />
            </Property>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_ControlMarchaParo
VAR
	_bSetaEmergenciaOk	AT %I*	: BOOL;
	_bPulsadorMarcha	AT %I*	: BOOL;
	_bPulsadorParo		AT %I*	: BOOL;
	_bPulsadorRearme	AT %I*	: BOOL;
	_bSalidaMotor		AT %Q*	: BOOL;
	
	_bEnMarcha					: BOOL;
	_bFalloSeguridad			: BOOL;
END_VAR</xhtml>
            </InterfaceAsPlainText>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>b1c2d3e4-f5a6-4b7c-8d9e-0f1a2b3c4d5e</ObjectId>
          </data>
        </addData>
      </pou>
      <pou name="MAIN" pouType="program">
        <interface>
          <localVars>
            <variable name="fbMaquina">
              <type>
                <derived name="FB_ControlMarchaParo" />
              </type>
            </variable>
            <variable name="bCmdMarcha">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="bCmdParo">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="bCmdRearme">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="bEstadoEnMarcha">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="bEstadoEmergencia">
              <type>
                <BOOL />
              </type>
            </variable>
            <addData>
              <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
                <InterfaceAsPlainText>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">PROGRAM MAIN
VAR
	// Instancia directa del bloque de función de control de máquina
	fbMaquina			: FB_ControlMarchaParo;
	
	// Variables para comandos de control por software (ej. HMI / ADS)
	bCmdMarcha			: BOOL;
	bCmdParo			: BOOL;
	bCmdRearme			: BOOL;
	
	// Variables de monitorización de estado
	bEstadoEnMarcha		: BOOL;
	bEstadoEmergencia	: BOOL;
END_VAR</xhtml>
                </InterfaceAsPlainText>
              </data>
            </addData>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// Ejecución periódica obligatoria de la lógica interna del bloque de control
fbMaquina.M_Cyclic();

// Procesamiento de comandos de control mediante métodos de la instancia
IF bCmdMarcha THEN
    fbMaquina.M_Marcha();
    bCmdMarcha := FALSE;
END_IF

IF bCmdParo THEN
    fbMaquina.M_Paro();
    bCmdParo := FALSE;
END_IF

IF bCmdRearme THEN
    fbMaquina.M_Rearmar();
    bCmdRearme := FALSE;
END_IF

// Lectura del estado operativo y de seguridad a través de las propiedades públicas
bEstadoEnMarcha := fbMaquina.P_EnMarcha;
bEstadoEmergencia := fbMaquina.P_EmergenciaActiva;</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">PROGRAM MAIN
VAR
	fbMaquina			: FB_ControlMarchaParo;
	
	bCmdMarcha			: BOOL;
	bCmdParo			: BOOL;
	bCmdRearme			: BOOL;
	
	bEstadoEnMarcha		: BOOL;
	bEstadoEmergencia	: BOOL;
END_VAR</xhtml>
            </InterfaceAsPlainText>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>c2d3e4f5-a6b7-4c8d-9e0f-1a2b3c4d5e6f</ObjectId>
          </data>
        </addData>
      </pou>
